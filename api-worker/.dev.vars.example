OPENAI_API_KEY=replace-with-openai-secret
# Dedicated service account: project ID must equal FIREBASE_PROJECT_ID.
# JSON value goes into a Cloudflare secret, never EXPO_PUBLIC_*.
FIREBASE_SERVICE_ACCOUNT=
# Required to revoke Sign in with Apple consent during deletion.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.cigdemgokdas.negiysem
APPLE_PRIVATE_KEY=

# Server-only RevenueCat v1 secret API key. Never prefix with EXPO_PUBLIC_.
REVENUECAT_SECRET_KEY=

# --- Worker degiskenleri (secret DEGIL) ---
# Asagidaki degerler api-worker/wrangler.toml [vars] icinde yasar; yerelde ihtiyac halinde buraya yazarak override edebilirsin:
#   OPENAI_MODEL, AI_RESERVATION_CENTS, AI_USER_DAILY_LIMIT,
#   UPLOAD_DAILY_GLOBAL_LIMIT, UPLOAD_USER_DAILY_LIMIT, STORAGE_MONTHLY_BYTES_LIMIT,
#   FIREBASE_PROJECT_NUMBER, APP_CHECK_ENFORCE (varsayilan "false", soft mod)
# Secret listesi degismedi: OPENAI_API_KEY, FIREBASE_SERVICE_ACCOUNT, REVENUECAT_SECRET_KEY, APPLE_*.
